<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" fill="none">
  <defs>
    <!-- Corporate Navy Background Gradient -->
    <linearGradient id="bg" x1="0" y1="0" x2="64" y2="64" gradientUnits="userSpaceOnUse">
      <stop stop-color="#0a162e"/>
      <stop offset="0.5" stop-color="#0f2042"/>
      <stop offset="1" stop-color="#1e3a8a"/>
    </linearGradient>

    <!-- Warm Golden Lunch Gradient -->
    <linearGradient id="gold" x1="12" y1="8" x2="52" y2="52" gradientUnits="userSpaceOnUse">
      <stop stop-color="#fffbeb"/>
      <stop offset="0.3" stop-color="#fef08a"/>
      <stop offset="0.7" stop-color="#f59e0b"/>
      <stop offset="1" stop-color="#d97706"/>
    </linearGradient>

    <!-- Soft Glow -->
    <radialGradient id="steamGlow" cx="32" cy="18" r="16" gradientUnits="userSpaceOnUse">
      <stop stop-color="#fef08a" stop-opacity="0.35"/>
      <stop offset="1" stop-color="#f59e0b" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <!-- Background rounded squircle -->
  <rect width="64" height="64" rx="16" fill="url(#bg)"/>
  
  <!-- Subtle border -->
  <rect x="1" y="1" width="62" height="62" rx="15" stroke="#60a5fa" stroke-opacity="0.3" stroke-width="2"/>

  <!-- Warm ambient glow -->
  <circle cx="32" cy="22" r="16" fill="url(#steamGlow)"/>

  <!-- Left: Fork -->
  <g fill="url(#gold)">
    <!-- Fork handle -->
    <rect x="8.5" y="27" width="2.5" height="21" rx="1.25"/>
    <!-- Fork neck -->
    <path d="M 6.5 22 C 6.5 26, 13 26, 13 22 Z"/>
    <!-- Fork tines -->
    <rect x="6.5" y="14" width="1.4" height="8" rx="0.7"/>
    <rect x="9.1" y="14" width="1.4" height="8" rx="0.7"/>
    <rect x="11.7" y="14" width="1.4" height="8" rx="0.7"/>
  </g>

  <!-- Right: Knife -->
  <g fill="url(#gold)">
    <!-- Knife handle -->
    <rect x="53" y="28" width="2.5" height="20" rx="1.25"/>
    <!-- Knife blade -->
    <path d="M 53 28 L 53 14 C 53 13, 56.5 15, 56.5 22 L 55.5 28 Z"/>
  </g>

  <!-- Center: Gourmet Lunch Cloche & Platter -->
  <g fill="url(#gold)">
    <!-- Platter tray base -->
    <rect x="15" y="44" width="34" height="3" rx="1.5"/>
    <rect x="13" y="47" width="38" height="2" rx="1" opacity="0.85"/>

    <!-- Cloche Serving Dome -->
    <path d="M 17 43 C 17 24, 47 24, 47 43 Z"/>

    <!-- Dome Handle Knob -->
    <circle cx="32" cy="19" r="3.2"/>
    <rect x="30.5" y="20.5" width="3" height="3"/>
  </g>

  <!-- Dome light reflection curve -->
  <path d="M 22 39 C 22 29, 30 26, 36 26" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round" fill="none" opacity="0.65"/>

  <!-- Rising Delicious Steam Wisps -->
  <g stroke="url(#gold)" stroke-width="1.8" stroke-linecap="round" fill="none" opacity="0.9">
    <path d="M 27 14 C 25.5 11, 28 9, 26.5 6"/>
    <path d="M 32 13 C 30.5 10, 33 8, 31.5 5"/>
    <path d="M 37 14 C 35.5 11, 38 9, 36.5 6"/>
  </g>
</svg>
